  <tag k="description" v="Калиновские родники: 6 компактно расположенных источников. Дебит от 0,5 до 2,2 л/с. Известны с первой половины XIX века, когда здесь велись разработки рассыпного золота. Родники оборудованы: вкопаны бетонные кольца, установлены срубы. Воду кипятить!"/>
  <tag k="drinking_water" v="yes"/>
  <tag k="name" v="Родники Калиновские"/>
  <tag k="natural" v="spring"/>
 </node>
